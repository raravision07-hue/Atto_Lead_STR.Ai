{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A business lead with CRM details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "website": { "type": "string" },
        "industry": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "facebook": { "type": "string" },
        "linkedin": { "type": "string" },
        "instagram": { "type": "string" },
        "twitter": { "type": "string" },
        "projectType": { "type": "string" },
        "clientManager": { "type": "string" },
        "processingWork": { "type": "string" },
        "opportunityScore": { "type": "number" },
        "cms": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of leads owned by a specific user."
    },
    "users/{userId}/private/profile": {
      "schema": "UserProfile",
      "description": "Private profile data for a user."
    }
  }
}
