rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprints
    function isValidLead(data) {
      return data.keys().hasAll(['companyName', 'userId', 'createdAt'])
        && data.companyName is string && data.companyName.size() <= 256
        && data.userId is string && data.userId.size() <= 128
        && data.createdAt is timestamp
        && (!('title' in data) || (data.title is string && data.title.size() <= 256))
        && (!('website' in data) || (data.website is string && data.website.size() <= 512))
        && (!('industry' in data) || (data.industry is string && data.industry.size() <= 128))
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 64))
        && (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 512))
        && (!('linkedin' in data) || (data.linkedin is string && data.linkedin.size() <= 512))
        && (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 512))
        && (!('twitter' in data) || (data.twitter is string && data.twitter.size() <= 512))
        && (!('projectType' in data) || (data.projectType is string && data.projectType.size() <= 128))
        && (!('clientManager' in data) || (data.clientManager is string && data.clientManager.size() <= 128))
        && (!('processingWork' in data) || (data.processingWork is string && data.processingWork.size() <= 5000))
        && (!('opportunityScore' in data) || (data.opportunityScore is number))
        && (!('cms' in data) || (data.cms is string && data.cms.size() <= 128))
        && (!('websiteIssues' in data) || (data.websiteIssues is list))
        && (!('status' in data) || (data.status is string && data.status.size() <= 64));
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.email == request.auth.token.email
        && data.createdAt == request.time
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128));
    }

    // Collections
    match /users/{userId} {
      // User private path
      match /private/profile {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProfile(incoming());
        allow update: if isOwner(userId) 
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
          && (incoming().updatedAt == request.time);
      }

      // User leads
      match /leads/{leadId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(leadId) 
          && isValidLead(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId) 
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && (
            // Action: Edit Any Lead Field
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'companyName', 'website', 'industry', 'email', 'phone', 
              'whatsapp', 'facebook', 'linkedin', 'instagram', 'twitter', 
              'projectType', 'clientManager', 'processingWork', 'opportunityScore', 
              'cms', 'status', 'websiteIssues', 'updatedAt'
            ])
            && (incoming().updatedAt == request.time)
          );
        allow delete: if isOwner(userId);
      }
    }
  }
}
